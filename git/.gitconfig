[user]
	name = Christian Köhn
	useConfigOnly = true

[alias]
	amend = commit --amend
	uncommit = reset --soft HEAD^
	unstage = restore --staged

[branch]
	sort = -committerdate

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green

[column]
	ui = auto

[commit]
	gpgsign = true
	verbose = true

[core]
	excludesfile = ~/.gitignore.local
	pager = delta

[diff]
	algorithm = histogram
	colorMoved = zebra
	colorMovedWS = allow-indentation-change

[delta]
	side-by-side = true
	navigate = true

[interactive]
	diffFilter = delta --color-only

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.git_allowed_signers

[help]
	autocorrect = prompt

[init]
	defaultBranch = main

[merge]
	conflictstyle = zdiff3
	ff = false
	summary = true
	tool = vimdiff
	verbosity = 1

[mergetool]
	keepBackup = false
	prompt = false

[fetch]
	prune = true
	pruneTags = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[rerere]
	enabled = true
	autoUpdate = true

[tag]
	gpgSign = true
	sort = version:refname

[include]
	path = ~/.gitconfig.local
